! Caps Lock -> Left Ctrl
keycode 66 = Control_L

! Left Ctrl -> Left Alt
keycode 37 = Alt_L

! Escape -> Caps Lock
keycode 9 = Caps_Lock

! Left Alt -> Escape
keycode 64 = Escape


! Modifier configuration
clear Lock
clear Control
clear Mod1

add Lock = Caps_Lock
add Control = Control_L
add Mod1 = Alt_L


